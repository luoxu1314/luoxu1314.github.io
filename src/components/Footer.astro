---
import { AUTHOR, GITHUB_URL } from '../consts';

const today = new Date();
---

<footer>
	<span>&copy; {today.getFullYear()} {AUTHOR}</span>
	<span class="sep">·</span>
	<a href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
	<span class="sep">·</span>
	<a href="/rss.xml">RSS</a>
</footer>
<style>
	footer {
		max-width: var(--content-width);
		margin: 4rem auto 0;
		padding: 2rem 1rem 3rem;
		border-top: 1px solid var(--border);
		color: var(--muted);
		font-size: 0.875rem;
	}
	footer a {
		color: var(--muted);
	}
	.sep {
		margin: 0 0.4em;
	}
</style>
